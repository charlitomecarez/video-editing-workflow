# Personal config
config.local.toml

# Media (never commit footage or renders)
*.mp4
*.mov
*.MOV
*.m4v
*.mkv
*.avi
*.mts
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.jpg
*.jpeg
*.png
!docs/**/*.png

# Projects: keep only text files (notes, scripts, Kdenlive projects, subtitles)
projects/**
!projects/**/
!projects/**/*.md
!projects/**/*.kdenlive
!projects/**/*.srt

# Kdenlive / OS / Python junk
*.kdenlive.bak*
*_proxy*
.DS_Store
__pycache__/

# References: keep reports and notes, not the videos or frames
references/**
!references/**/
!references/**/*.md
!references/**/*.csv
!references/**/*.srt
