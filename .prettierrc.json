{
  "$schema": "https://json.schemastore.org/prettierrc",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "proseWrap": "preserve",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "animations/**/*.{ts,tsx,mjs}",
      "options": { "singleQuote": true, "bracketSpacing": false }
    }
  ]
}
